# Neon Postgres connection string. Vercel fills this in for you when you add
# the Neon integration, otherwise copy it from the Neon dashboard.
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Signs the login cookie. At least 32 characters, and keep it secret.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# One-time code that creates the very first system owner account.
# It stops working the moment a system owner exists.
SETUP_CODE="pick-something-only-you-know"
